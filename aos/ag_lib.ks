FUNCTION AG_NATIVE_IS_ACTIVE {
  PARAMETER id.

  IF id = 0 { RETURN SHIP:CONTROL:GEAR. }

       IF id = 1 { RETURN AG1. }
  ELSE IF id = 2 { RETURN AG2. }
  ELSE IF id = 3 { RETURN AG3. }
